    def fix_import_violations_batch(self, python_files):
        """批量修复导入违规"""
        logger.info("批量修复导入违规...")
        
        for file_path in python_files:
            try:
                with open(file_path, 'r', encoding='utf-8') as f:
                    content = f.read()
                
                original_content = content
                
                # 修复相对导入
                relative_import_pattern = r'from\s+(\.+)(\w*)\s+import'
                
                def fix_relative_import_massivecompliancefix(match):
                    dots = match.group(1)
                    module = match.group(2)
                    
                    # 计算绝对路径
                    relative_path = file_path.relative_to(self.root_dir)
                    parts = relative_path.parts[:-1]  # 排除文件名
                    
                    if len(dots) == 1:  # from scripts.utils. import
                        if parts:
                            return f'from {".".join(parts)}.{module} import'
                        else:
                            return f'from {module} import'
                    elif len(dots) == 2:  # from scripts. import
                        if len(parts) > 1:
                            return f'from {".".join(parts[:-1])}.{module} import'
                        else:
                            return f'from {module} import'
                    
                    return match.group(0)  # 保持原样
                
                content = re.sub(relative_import_pattern, fix_relative_import_massivecompliancefix, content)
                
                if content != original_content:
                    with open(file_path, 'w', encoding='utf-8') as f:
                        f.write(content)
                    self.fixes_applied['import_violations'] += 1
                    logger.info(f"修复导入违规: {file_path}")
            
            except Exception as e:
                logger.warning(f"修复文件 {file_path} 导入违规失败: {e}")
    
    def camel_to_snake(self, text: str) -> str:
        """将驼峰命名转换为下划线命名"""
        # 在大写字母前插入下划线
        s1 = re.sub('(.)([A-Z][a-z]+)', r'\1_\2', text)
        # 在小写字母和大写字母之间插入下划线
        return re.sub('([a-z0-9])([A-Z])', r'\1_\2', s1).lower()
    
    def generate_massive_fix_report(self):
        """生成大规模修复报告"""
        total_fixes = sum(self.fixes_applied.values())
        
        report = {
            'timestamp': str(Path().cwd()),
            'total_fixes_applied': total_fixes,
            'fixes_by_type': self.fixes_applied,
            'strategy': 'massive_batch_fixing',
            'target_violations': [
                'naming_violations (4959)',
                'code_duplications (841)', 
                'layer_violations (421)',
                'query_violations (40)',
                'import_violations (25)',
                'db_dependencies (20)'
            ]
        }
        
        # 保存报告
        report_path = self.root_dir / 'data/result/massive_fix_report.json'
        report_path.parent.mkdir(parents=True, exist_ok=True)
        
        with open(report_path, 'w', encoding='utf-8') as f:
            json.dump(report, f, indent=2, ensure_ascii=False)
        
        logger.info(f"大规模修复报告已保存: {report_path}")
        
        # 打印摘要
        print(f"\n🚀 大规模修复完成!")
        print(f"总计修复: {total_fixes} 个问题")
        for fix_type, count in self.fixes_applied.items():
            if count > 0:
                print(f"  - {fix_type}: {count}")

