    def fix_massive_violations(self):
        """修复大规模违规"""
        logger.info("开始大规模合规性修复...")
        
        # 获取所有Python文件
        python_files = list(self.root_dir.rglob("*.py"))
        python_files = [f for f in python_files if not any(exclude in str(f) for exclude in [
            '__pycache__', '.git', 'venv', '.pytest_cache', 'node_modules'
        ])]
        
        logger.info(f"处理 {len(python_files)} 个Python文件")
        
        # 批量修复命名违规
        self.fix_naming_violations_batch(python_files)
        
        # 批量修复代码重复
        self.fix_code_duplications_batch(python_files)
        
        # 批量修复分层违规
        self.fix_layer_violations_batch(python_files)
        
        # 批量修复查询违规
        self.fix_query_violations_batch(python_files)
        
        # 批量修复数据库依赖
        self.fix_db_dependencies_batch(python_files)
        
        # 批量修复导入违规
        self.fix_import_violations_batch(python_files)
        
        # 生成修复报告
        self.generate_massive_fix_report()
    
    def fix_naming_violations_batch(self, python_files):
        """批量修复命名违规"""
        logger.info("批量修复命名违规...")
        
        for file_path in python_files:
            try:
                with open(file_path, 'r', encoding='utf-8') as f:
                    content = f.read()
                
                original_content = content
                
                # 应用命名修复
                for wrong_name, correct_name in self.naming_fixes.items():
                    # 类名修复
                    content = re.sub(rf'\bclass\s+{re.escape(wrong_name)}\b', f'class {correct_name}', content)
                    # 函数名修复
                    content = re.sub(rf'\bdef\s+{re.escape(wrong_name)}\b', f'def {correct_name}', content)
                    # 变量名修复
                    content = re.sub(rf'\b{re.escape(wrong_name)}\s*=', f'{correct_name} =', content)
                    # 调用修复
                    content = re.sub(rf'\.{re.escape(wrong_name)}\(', f'.{correct_name}(', content)
                
                # 通用命名规范修复
                # 修复驼峰命名的变量为下划线命名
                content = re.sub(r'\b([a-z]+)([A-Z][a-z]*)+\s*=', 
                                lambda m: self.camel_to_snake(m.group(0)), content)
                
                # 修复小写开头的类名
                content = re.sub(r'\bclass\s+([a-z]\w*)\b', 
                                lambda m: f'class {m.group(1).capitalize()}', content)
                
                if content != original_content:
                    with open(file_path, 'w', encoding='utf-8') as f:
                        f.write(content)
                    self.fixes_applied['naming_violations'] += 1
                    logger.info(f"修复命名违规: {file_path}")
            
            except Exception as e:
                logger.warning(f"修复文件 {file_path} 命名违规失败: {e}")
    
    def fix_code_duplications_batch(self, python_files):
        """批量修复代码重复"""
        logger.info("批量修复代码重复...")
        
        # 收集所有重复的名称
        name_files = defaultdict(list)
        
        for file_path in python_files:
            try:
                with open(file_path, 'r', encoding='utf-8') as f:
                    content = f.read()
                
                try:
                    tree = ast.parse(content)
                    for node in ast.walk(tree):
                        if isinstance(node, (ast.Class_def, ast.Function_def)):
                            # 跳过特殊方法
                            if node.name.startswith('__') and node.name.endswith('__'):
                                continue
                            name_files[node.name].append(file_path)
                except Syntax_error:
                    continue
            except Exception as e:
                continue
        
        # 修复重复名称
        duplicate_counter = defaultdict(int)
        
        for name, files in name_files.items():
            if len(files) > 1:
                for file_path in files:
                    duplicate_counter[name] += 1
                    if duplicate_counter[name] == 1:
                        continue  # 保持第一个不变
                    
                    try:
                        with open(file_path, 'r', encoding='utf-8') as f:
                            content = f.read()
                        
                        # 生成唯一名称
                        module_name = file_path.stem.replace('_', '').capitalize()
                        new_name = f"{name}{module_name}"
                        
                        # 替换名称
                        content = re.sub(rf'\b{re.escape(name)}\b', new_name, content)
                        
                        with open(file_path, 'w', encoding='utf-8') as f:
                            f.write(content)
                        
                        self.fixes_applied['code_duplications'] += 1
                        logger.info(f"修复重复名称 {name} -> {new_name} in {file_path}")
                    
                    except Exception as e:
                        logger.warning(f"修复重复名称失败: {e}")
    
    def fix_layer_violations_batch(self, python_files):
        """批量修复分层违规"""
        logger.info("批量修复分层违规...")
        
        for file_path in python_files:
            try:
                relative_path = file_path.relative_to(self.root_dir)
                parts = relative_path.parts
                
                if len(parts) < 2:
                    continue
                
                current_layer = parts[0]
                
                with open(file_path, 'r', encoding='utf-8') as f:
                    content = f.read()
                
                original_content = content
                
                # 根据当前层应用修复规则
                if current_layer == 'config':
                    # config层不应该导入其他业务层
                    for pattern, replacement in self.layer_violation_fixes.items():
                        if 'config should not import' in replacement:
                            content = re.sub(pattern, replacement, content, flags=re.MULTILINE)
                
                elif current_layer == 'utils':
                    # utils层不应该导入业务层
                    for pattern, replacement in self.layer_violation_fixes.items():
                        if 'utils should not import' in replacement:
                            content = re.sub(pattern, replacement, content, flags=re.MULTILINE)
                
                if content != original_content:
                    with open(file_path, 'w', encoding='utf-8') as f:
                        f.write(content)
                    self.fixes_applied['layer_violations'] += 1
                    logger.info(f"修复分层违规: {file_path}")
            
            except Exception as e:
                logger.warning(f"修复文件 {file_path} 分层违规失败: {e}")
    
    def fix_query_violations_batch(self, python_files):
        """批量修复查询违规"""
        logger.info("批量修复查询违规...")
        
        for file_path in python_files:
            try:
                with open(file_path, 'r', encoding='utf-8') as f:
                    content = f.read()
                
                original_content = content
                
                # 应用查询修复
                for pattern, replacement in self.query_fixes.items():
                    content = re.sub(pattern, replacement, content, flags=re.IGNORECASE | re.MULTILINE)
                
                if content != original_content:
                    with open(file_path, 'w', encoding='utf-8') as f:
                        f.write(content)
                    self.fixes_applied['query_violations'] += 1
                    logger.info(f"修复查询违规: {file_path}")
            
            except Exception as e:
                logger.warning(f"修复文件 {file_path} 查询违规失败: {e}")
    
