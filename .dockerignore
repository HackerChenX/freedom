# Docker ignore patterns for production builds

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Logs
*.log
logs/

# Test files
.pytest_cache/
.coverage
htmlcov/
.tox/
.coverage
.coverage.*
coverage.xml

# Documentation
docs/_build/
.readthedocs.yml

# Development files
docker-compose.yml
docker-compose.dev.yml
Dockerfile.dev
.env.local
.env.dev

# Large data files
*.csv
*.xlsx
*.xls
data/
archive/

# Temporary files
tmp/
temp/
*.tmp

# Cache
cache/
.cache/

# Results and outputs
results/
output/

# Configuration secrets
*.key
*.pem
*.cert
secrets.yaml
.env.prod

# Backup files
*.backup
*.bak