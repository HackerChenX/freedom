#!/usr/bin/env python3
"""
第二批测试：趋势指标扩展（10个）

测试目标：
- 验证趋势分析相关指标的计算准确性
- 测试多周期数据支持
- 验证指标信号生成逻辑
- 评估性能表现

测试指标：
EMA, WMA, TRIX, DMI, ADX, SAR, AROON, DMA, BIAS, VORTEX
"""

import sys
import os
import time
from typing import Dict, List, Any, Optional
import pandas as pd
import numpy as np
from datetime import datetime, timedelta

# 添加项目根目录到Python路径
root_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, root_dir)

from utils.dependency_injection import get_service
from db.interfaces.data_access_interface import IDataAccess
from utils.logger import get_logger

logger = get_logger(__name__)


class Phase2TrendIndicatorTester:
    """第二批趋势指标测试器"""
    
    def __init__(self):
        self.data_access = get_container().resolve(IDataAccess)
        self.stock_pool_size = 100
        self.test_stocks_per_indicator = 5
        self.latest_date = self._get_latest_data_date_Batch_Test_Phase2_Trend_Indicators_Fixed()
        
        # 第二批测试指标配置
        self.indicators_config = {
            'EMA': {
                'name': '指数移动平均线',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'period': 12},
                'complexity': '简单'
            },
            'WMA': {
                'name': '加权移动平均线',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'period': 20},
                'complexity': '简单'
            },
            'TRIX': {
                'name': 'TRIX指标',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'period': 14},
                'complexity': '中等'
            },
            'DMI': {
                'name': '趋向指标',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'period': 14},
                'complexity': '中等'
            },
            'ADX': {
                'name': '平均趋向指标',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'period': 14},
                'complexity': '中等'
            },
            'SAR': {
                'name': '抛物线转向',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'acceleration': 0.02, 'maximum': 0.2},
                'complexity': '中等'
            },
            'AROON': {
                'name': 'Aroon指标',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'period': 25},
                'complexity': '中等'
            },
            'DMA': {
                'name': '动态移动平均',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'short': 10, 'long': 50},
                'complexity': '简单'
            },
            'BIAS': {
                'name': '乖离率',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'period': 20},
                'complexity': '简单'
            },
            'VORTEX': {
                'name': '涡流指标',
                'category': '趋势指标',
                'periods': ['1d'],
                'params': {'period': 14},
                'complexity': '复杂'
            }
        }
        
        logger.info(f"第二批趋势指标测试器初始化完成")
        logger.info(f"最新数据日期: {self.latest_date}")
        logger.info(f"测试指标数量: {len(self.indicators_config)}")
    
    def _get_latest_data_date_Batch_Test_Phase2_Trend_Indicators_Fixed(self) -> str:
        """获取数据库中的最新数据日期"""
        try:
            result = self.data_access.execute_query('SELECT MAX(date) as max_date FROM stock_info WHERE date >= '2020-01-01' LIMIT 1')
            if not result.empty:
                return str(result.iloc[0]['max_date'])
            return "2025-05-23"
        except Exception as e:
            logger.error(f"获取最新数据日期失败: {e}")
            return "2025-05-23"
    
    def _get_stock_pool_Batch_Test_Phase2_Trend_Indicators_Fixed(self, period: str = '1d') -> List[str]:
        """获取股票池"""
        try:
            table_name = 'stock_info'
            
            query = f"""
            SELECT DISTINCT code 
            FROM {table_name} 
            WHERE date = '{self.latest_date}'
              AND volume > 0 
              AND close > 0
            ORDER BY volume DESC 
            LIMIT {self.stock_pool_size}
            """
            
            result = self.data_access.execute_query(query)
            if not result.empty:
                return result['code'].tolist()
            return []
        except Exception as e:
            logger.error(f"获取股票池失败: {e}")
            return []
    
    def _load_stock_data_Batch_Test_Phase2_Trend_Indicators_Fixed(self, stock_codes: List[str], period: str = '1d', 
                        days_back: int = 100) -> pd.DataFrame:
        """加载股票数据"""
        try:
            table_name = 'stock_info'
            
            codes_str = "', '".join(stock_codes)
            
            query = f"""
            SELECT code, date, open, high, low, close, volume
            FROM {table_name}
            WHERE code IN ('{codes_str}')
              AND date <= '{self.latest_date}'
            ORDER BY code, date DESC
            LIMIT {len(stock_codes) * days_back}
            """
            
            result = self.data_access.execute_query(query)
            if not result.empty:
                # 转换数据类型
                result['date'] = pd.to_datetime(result['date'])
                for col in ['open', 'high', 'low', 'close', 'volume']:
                    result[col] = pd.to_numeric(result[col], errors='coerce')
                
                # 按股票代码和日期排序
                result = result.sort_values(['code', 'date']).reset_index(drop=True)
                
            return result
        except Exception as e:
            logger.error(f"加载股票数据失败: {e}")
            return pd.DataFrame()
    
    def _calculate_ema(self, prices: pd.Series, period: int) -> pd.Series:
        """计算指数移动平均线"""
        return prices.ewm(span=period, adjust=False).mean()
    
    def _calculate_wma(self, prices: pd.Series, period: int) -> pd.Series:
        """计算加权移动平均线"""
        def wma_single(values):
            if len(values) < period:
                return np.nan
            weights = np.arange(1, period + 1)
            return np.dot(values[-period:], weights) / weights.sum()
        
        return prices.rolling(window=period).apply(wma_single, raw=True)
    
    def _calculate_trix(self, prices: pd.Series, period: int) -> pd.Series:
        """计算TRIX指标"""
        # 三重指数平滑
        ema1 = prices.ewm(span=period, adjust=False).mean()
        ema2 = ema1.ewm(span=period, adjust=False).mean()
        ema3 = ema2.ewm(span=period, adjust=False).mean()
        
        # TRIX = (EMA3今日 - EMA3昨日) / EMA3昨日 * 10000
        trix = (ema3 - ema3.shift(1)) / ema3.shift(1) * 10000
        return trix
    
    def _calculate_dmi_adx(self, high: pd.Series, low: pd.Series, close: pd.Series, period: int):
        """计算DMI和ADX指标"""
        # 计算TR (True Range)
        high_low = high - low
        high_close = np.abs(high - close.shift(1))
        low_close = np.abs(low - close.shift(1))
        tr = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)
        
        # 计算DM (Directional Movement)
        plus_dm = high - high.shift(1)
        minus_dm = low.shift(1) - low
        
        plus_dm = pd.Series(np.where((plus_dm > minus_dm) & (plus_dm > 0), plus_dm, 0), index=high.index)
        minus_dm = pd.Series(np.where((minus_dm > plus_dm) & (minus_dm > 0), minus_dm, 0), index=low.index)
        
        # 计算平滑的TR和DM
        atr = tr.rolling(window=period).mean()
        plus_di = 100 * (plus_dm.rolling(window=period).mean() / atr)
        minus_di = 100 * (minus_dm.rolling(window=period).mean() / atr)
        
        # 计算ADX
        dx = 100 * np.abs(plus_di - minus_di) / (plus_di + minus_di)
        adx = dx.rolling(window=period).mean()
        
        return plus_di, minus_di, adx
    
    def _calculate_sar(self, high: pd.Series, low: pd.Series, close: pd.Series, 
                      acceleration: float = 0.02, maximum: float = 0.2):
        """计算SAR指标"""
        sar = pd.Series(index=close.index, dtype=float)
        af = acceleration
        ep = high.iloc[0] if close.iloc[1] > close.iloc[0] else low.iloc[0]
        trend = 1 if close.iloc[1] > close.iloc[0] else -1
        
        sar.iloc[0] = low.iloc[0] if trend == 1 else high.iloc[0]
        
        for i in range(1, len(close)):
            if trend == 1:  # 上升趋势
                sar.iloc[i] = sar.iloc[i-1] + af * (ep - sar.iloc[i-1])
                
                if high.iloc[i] > ep:
                    ep = high.iloc[i]
                    af = min(af + acceleration, maximum)
                
                if low.iloc[i] <= sar.iloc[i]:
                    trend = -1
                    sar.iloc[i] = ep
                    ep = low.iloc[i]
                    af = acceleration
            else:  # 下降趋势
                sar.iloc[i] = sar.iloc[i-1] + af * (ep - sar.iloc[i-1])
                
                if low.iloc[i] < ep:
                    ep = low.iloc[i]
                    af = min(af + acceleration, maximum)
                
                if high.iloc[i] >= sar.iloc[i]:
                    trend = 1
                    sar.iloc[i] = ep
                    ep = high.iloc[i]
                    af = acceleration
        
        return sar
    
    def _calculate_aroon(self, high: pd.Series, low: pd.Series, period: int):
        """计算Aroon指标"""
        def aroon_up_single(values):
            if len(values) < period:
                return np.nan
            return ((period - np.argmax(values[-period:])) / period) * 100
        
        def aroon_down_single(values):
            if len(values) < period:
                return np.nan
            return ((period - np.argmin(values[-period:])) / period) * 100
        
        aroon_up = high.rolling(window=period).apply(aroon_up_single, raw=True)
        aroon_down = low.rolling(window=period).apply(aroon_down_single, raw=True)
        aroon_oscillator = aroon_up - aroon_down
        
        return aroon_up, aroon_down, aroon_oscillator
    
    def _calculate_bias(self, close: pd.Series, period: int) -> pd.Series:
        """计算乖离率"""
        ma = close.rolling(window=period).mean()
        bias = ((close - ma) / ma) * 100
        return bias
    
    def _calculate_vortex(self, high: pd.Series, low: pd.Series, close: pd.Series, period: int):
        """计算涡流指标"""
        # 计算VM (Vortex Movement)
        vm_plus = np.abs(high - low.shift(1))
        vm_minus = np.abs(low - high.shift(1))
        
        # 计算TR (True Range)
        high_low = high - low
        high_close = np.abs(high - close.shift(1))
        low_close = np.abs(low - close.shift(1))
        tr = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)
        
        # 计算VI (Vortex Indicator)
        vi_plus = vm_plus.rolling(window=period).sum() / tr.rolling(window=period).sum()
        vi_minus = vm_minus.rolling(window=period).sum() / tr.rolling(window=period).sum()
        
        return vi_plus, vi_minus
    
    def validate_indicator_Batch_Test_Phase2_Trend_Indicators_Fixed(self, indicator_name: str, period: str = '1d') -> Dict[str, Any]:
        """验证单个指标"""
        logger.info(f"开始验证指标: {indicator_name} (周期: {period})")
        
        try:
            # 获取股票池
            stock_pool = self._get_stock_pool_Batch_Test_Phase2_Trend_Indicators_Fixed(period)
            if not stock_pool:
                return {
                    'indicator': indicator_name,
                    'period': period,
                    'status': 'FAILED',
                    'error': '获取股票池失败',
                    'tested_stocks': 0,
                    'successful_stocks': 0
                }
            
            # 选择测试股票
            test_stocks = stock_pool[:self.test_stocks_per_indicator]
            
            # 加载数据
            stock_data = self._load_stock_data_Batch_Test_Phase2_Trend_Indicators_Fixed(test_stocks, period)
            if stock_data.empty:
                return {
                    'indicator': indicator_name,
                    'period': period,
                    'status': 'FAILED',
                    'error': '加载股票数据失败',
                    'tested_stocks': 0,
                    'successful_stocks': 0
                }
            
            # 执行指标计算验证
            return self._validate_trend_indicator(stock_data, period, indicator_name)
            
        except Exception as e:
            logger.error(f"验证指标 {indicator_name} 失败: {e}")
            return {
                'indicator': indicator_name,
                'period': period,
                'status': 'FAILED',
                'error': str(e),
                'tested_stocks': 0,
                'successful_stocks': 0
            }
    
    def _validate_trend_indicator(self, stock_data: pd.DataFrame, period: str, 
                                indicator_name: str) -> Dict[str, Any]:
        """验证趋势指标"""
        config = self.indicators_config[indicator_name]
        successful_stocks = 0
        total_stocks = len(stock_data['code'].unique())
        detailed_results = []
        
        for stock_code in stock_data['code'].unique():
            try:
                stock_df = stock_data[stock_data['code'] == stock_code].copy()
                stock_df = stock_df.sort_values('date').reset_index(drop=True)
                
                if len(stock_df) < 30:  # 需要足够的数据点
                    continue
                
                # 获取最新数据点
                latest_data = stock_df.iloc[-1]
                
                # 根据指标类型计算
                result = None
                if indicator_name == 'EMA':
                    ema = self._calculate_ema(stock_df['close'], config['params']['period'])
                    result = {
                        'value': float(ema.iloc[-1]) if not pd.isna(ema.iloc[-1]) else None,
                        'signal': 'BUY' if latest_data['close'] > ema.iloc[-1] else 'SELL'
                    }
                
                elif indicator_name == 'WMA':
                    wma = self._calculate_wma(stock_df['close'], config['params']['period'])
                    result = {
                        'value': float(wma.iloc[-1]) if not pd.isna(wma.iloc[-1]) else None,
                        'signal': 'BUY' if latest_data['close'] > wma.iloc[-1] else 'SELL'
                    }
                
                elif indicator_name == 'TRIX':
                    trix = self._calculate_trix(stock_df['close'], config['params']['period'])
                    result = {
                        'value': float(trix.iloc[-1]) if not pd.isna(trix.iloc[-1]) else None,
                        'signal': 'BUY' if trix.iloc[-1] > 0 else 'SELL'
                    }
                
                elif indicator_name in ['DMI', 'ADX']:
                    plus_di, minus_di, adx = self._calculate_dmi_adx(
                        stock_df['high'], stock_df['low'], stock_df['close'], 
                        config['params']['period']
                    )
                    if indicator_name == 'DMI':
                        result = {
                            'plus_di': float(plus_di.iloc[-1]) if not pd.isna(plus_di.iloc[-1]) else None,
                            'minus_di': float(minus_di.iloc[-1]) if not pd.isna(minus_di.iloc[-1]) else None,
                            'signal': 'UPTREND' if plus_di.iloc[-1] > minus_di.iloc[-1] else 'DOWNTREND'
                        }
                    else:  # ADX
                        result = {
                            'value': float(adx.iloc[-1]) if not pd.isna(adx.iloc[-1]) else None,
                            'signal': 'STRONG_TREND' if adx.iloc[-1] > 25 else 'WEAK_TREND'
                        }
                
                elif indicator_name == 'SAR':
                    sar = self._calculate_sar(stock_df['high'], stock_df['low'], stock_df['close'],
                                            config['params']['acceleration'], config['params']['maximum'])
                    result = {
                        'value': float(sar.iloc[-1]) if not pd.isna(sar.iloc[-1]) else None,
                        'signal': 'BUY' if latest_data['close'] > sar.iloc[-1] else 'SELL'
                    }
                
                elif indicator_name == 'AROON':
                    aroon_up, aroon_down, aroon_osc = self._calculate_aroon(
                        stock_df['high'], stock_df['low'], config['params']['period']
                    )
                    result = {
                        'aroon_up': float(aroon_up.iloc[-1]) if not pd.isna(aroon_up.iloc[-1]) else None,
                        'aroon_down': float(aroon_down.iloc[-1]) if not pd.isna(aroon_down.iloc[-1]) else None,
                        'oscillator': float(aroon_osc.iloc[-1]) if not pd.isna(aroon_osc.iloc[-1]) else None,
                        'signal': 'UPTREND' if aroon_up.iloc[-1] > 70 else ('DOWNTREND' if aroon_down.iloc[-1] > 70 else 'CONSOLIDATION')
                    }
                
                elif indicator_name == 'DMA':
                    short_ma = stock_df['close'].rolling(window=config['params']['short']).mean()
                    long_ma = stock_df['close'].rolling(window=config['params']['long']).mean()
                    dma = short_ma - long_ma
                    result = {
                        'value': float(dma.iloc[-1]) if not pd.isna(dma.iloc[-1]) else None,
                        'signal': 'BUY' if dma.iloc[-1] > 0 else 'SELL'
                    }
                
                elif indicator_name == 'BIAS':
                    bias = self._calculate_bias(stock_df['close'], config['params']['period'])
                    result = {
                        'value': float(bias.iloc[-1]) if not pd.isna(bias.iloc[-1]) else None,
                        'signal': 'OVERBOUGHT' if bias.iloc[-1] > 6 else ('OVERSOLD' if bias.iloc[-1] < -6 else 'NORMAL')
                    }
                
                elif indicator_name == 'VORTEX':
                    vi_plus, vi_minus = self._calculate_vortex(
                        stock_df['high'], stock_df['low'], stock_df['close'], 
                        config['params']['period']
                    )
                    result = {
                        'vi_plus': float(vi_plus.iloc[-1]) if not pd.isna(vi_plus.iloc[-1]) else None,
                        'vi_minus': float(vi_minus.iloc[-1]) if not pd.isna(vi_minus.iloc[-1]) else None,
                        'signal': 'BULLISH' if vi_plus.iloc[-1] > vi_minus.iloc[-1] else 'BEARISH'
                    }
                
                if result and any(v is not None for v in result.values() if isinstance(v, (int, float))):
                    successful_stocks += 1
                    detailed_results.append({
                        'stock_code': stock_code,
                        'date': str(latest_data['date']),
                        'close_price': float(latest_data['close']),
                        'indicator_result': result
                    })
                
            except Exception as e:
                logger.warning(f"计算股票 {stock_code} 的 {indicator_name} 指标失败: {e}")
                continue
        
        success_rate = (successful_stocks / total_stocks * 100) if total_stocks > 0 else 0
        
        return {
            'indicator': indicator_name,
            'period': period,
            'status': 'SUCCESS' if success_rate >= 80 else 'PARTIAL',
            'tested_stocks': total_stocks,
            'successful_stocks': successful_stocks,
            'success_rate': round(success_rate, 2),
            'complexity': config['complexity'],
            'sample_results': detailed_results[:3]  # 显示前3个结果作为样例
        }
    
    def run_batch_test(self) -> Dict[str, Any]:
        """运行第二批批量测试"""
        logger.info("=" * 60)
        logger.info("开始第二批测试：趋势指标扩展")
        logger.info("=" * 60)
        
        start_time = time.time()
        validation_results = {
            'batch_info': {
                'batch_number': 2,
                'batch_name': '趋势指标扩展',
                'total_indicators': len(self.indicators_config),
                'test_date': self.latest_date
            },
            'results': {},
            'summary': {}
        }
        
        total_indicators = len(self.indicators_config)
        successful_indicators = 0
        
        for i, (indicator_name, config) in enumerate(self.indicators_config.items(), 1):
            logger.info(f"进度: {i}/{total_indicators} - 测试指标: {indicator_name}")
            
            for period in config['periods']:
                result = self.validate_indicator_Batch_Test_Phase2_Trend_Indicators_Fixed(indicator_name, period)
                
                key = f"{indicator_name}_{period}"
                validation_results['results'][key] = result
                
                if result['status'] in ['SUCCESS', 'PARTIAL']:
                    successful_indicators += 1
                
                logger.info(f"  {indicator_name} ({period}): {result['status']} - "
                           f"成功率: {result.get('success_rate', 0):.1f}%")
        
        end_time = time.time()
        execution_time = end_time - start_time
        
        # 计算总体统计
        total_tests = sum(len(config['periods']) for config in self.indicators_config.values())
        success_rate = (successful_indicators / total_tests * 100) if total_tests > 0 else 0
        
        validation_results['summary'] = {
            'total_tests': total_tests,
            'successful_tests': successful_indicators,
            'success_rate': round(success_rate, 2),
            'execution_time': round(execution_time, 2),
            'average_time_per_indicator': round(execution_time / total_tests, 2)
        }
        
        self._print_batch_summary(validation_results)
        return validation_results
    
    def _print_batch_summary(self, results: Dict[str, Any]):
        """打印批量测试总结"""
        logger.info("\n" + "=" * 60)
        logger.info("第二批测试总结：趋势指标扩展")
        logger.info("=" * 60)
        
        summary = results['summary']
        logger.info(f"测试指标总数: {summary['total_tests']}")
        logger.info(f"成功测试数: {summary['successful_tests']}")
        logger.info(f"总体成功率: {summary['success_rate']:.1f}%")
        logger.info(f"总执行时间: {summary['execution_time']:.2f}秒")
        logger.info(f"平均每指标时间: {summary['average_time_per_indicator']:.2f}秒")
        
        logger.info("\n详细结果:")
        for key, result in results['results'].items():
            status_icon = "✅" if result['status'] == 'SUCCESS' else ("⚠️" if result['status'] == 'PARTIAL' else "❌")
            logger.info(f"  {status_icon} {result['indicator']} ({result['period']}): "
                       f"{result['status']} - 成功率: {result.get('success_rate', 0):.1f}%")
        
        # 按复杂度分类统计
        complexity_stats = {}
        for result in results['results'].values():
            complexity = result.get('complexity', 'Unknown')
            if complexity not in complexity_stats:
                complexity_stats[complexity] = {'total': 0, 'success': 0}
            complexity_stats[complexity]['total'] += 1
            if result['status'] in ['SUCCESS', 'PARTIAL']:
                complexity_stats[complexity]['success'] += 1
        
        logger.info("\n按复杂度分类统计:")
        for complexity, stats in complexity_stats.items():
            success_rate = (stats['success'] / stats['total'] * 100) if stats['total'] > 0 else 0
            logger.info(f"  {complexity}: {stats['success']}/{stats['total']} ({success_rate:.1f}%)")


def main():
    """主函数"""
    try:
        tester = Phase2TrendIndicatorTester()
        results = tester.run_batch_test()
        
        # 保存测试结果
        import json
        result_file = f"data/result/phase2_trend_indicators_test_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        os.makedirs(os.path.dirname(result_file), exist_ok=True)
        
        with open(result_file, 'w', encoding='utf-8') as f:
            json.dump(results, f, ensure_ascii=False, indent=2)
        
        logger.info(f"\n测试结果已保存到: {result_file}")
        
        return results
        
    except Exception as e:
        logger.error(f"第二批测试执行失败: {e}")
        return None


if __name__ == "__main__":
    main()
