#!/usr/bin/python
# -*- coding: UTF-8 -*-

"""
数据库性能优化脚本

基于性能测试结果，实施数据库优化措施
"""

import sys
import os
import time
from datetime import datetime
from typing import Dict, List, Optional, Any

# 添加项目根目录到路径
project_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.append(project_root)

from utils.logger import get_logger

logger = get_logger(__name__)


class DatabaseOptimizer:
    """数据库优化器"""
    
    def __init__(self):
        self.client = None
        self.optimization_results = {
            'indexes_created': [],
            'optimizations_applied': [],
            'performance_improvements': {},
            'errors': []
        }
        
        # 初始化ClickHouse连接
        self._init_clickhouse_connection_Database_Optimization()
    
    def _init_clickhouse_connection_Database_Optimization(self):
        """初始化ClickHouse连接"""
        try:
            import clickhouse_connect
            self.client = clickhouse_connect.get_client(
                host=os.getenv('DB_HOST', 'localhost'), 
                port=int(os.getenv('DB_PORT', '8123')), 
                database=os.getenv('DB_DATABASE', 'stock')
            )
            logger.info("ClickHouse连接初始化成功")
        except Exception as e:
            logger.error(f"ClickHouse连接初始化失败: {e}")
            self.client = None
    
    def analyze_current_performance(self) -> Dict[str, Any]:
        """分析当前数据库性能"""
        logger.info("开始分析当前数据库性能...")
        
        if not self.client:
            return {'error': 'ClickHouse连接未建立'}
        
        performance_baseline = {}
        
        try:
            # 1. 检查表结构
            logger.info("检查表结构...")
            table_info = self.client.query("DESCRIBE stock_info")
            performance_baseline['table_structure'] = [
                {'name': row[0], 'type': row[1]} for row in table_info.result_rows
            ]
            
            # 2. 检查现有索引
            logger.info("检查现有索引...")
            try:
                indexes_info = self.client.query("SHOW CREATE TABLE stock_info")
                performance_baseline['current_indexes'] = indexes_info.result_rows[0][1] if indexes_info.result_rows else "No indexes found"
            except Exception as e:
                performance_baseline['current_indexes'] = f"Error checking indexes: {e}"
            
            # 3. 分析数据分布
            logger.info("分析数据分布...")
            data_stats = self.client.query("""
                SELECT 
                    COUNT(*) as total_records,
                    COUNT(DISTINCT code) as unique_stocks,
                    MIN(date) as earliest_date,
                    MAX(date) as latest_date,
                    AVG(volume) as avg_volume,
                    AVG(close) as avg_price
                FROM stock_info WHERE date >= '2020-01-01'
            """)
            
            if data_stats.result_rows:
                row = data_stats.result_rows[0]
                performance_baseline['data_statistics'] = {
                    'total_records': row[0],
                    'unique_stocks': row[1],
                    'earliest_date': str(row[2]),
                    'latest_date': str(row[3]),
                    'avg_volume': float(row[4]) if row[4] else 0,
                    'avg_price': float(row[5]) if row[5] else 0
                }
            
            # 4. 测试查询性能基线
            logger.info("测试查询性能基线...")
            performance_baseline['query_baseline'] = self._measure_query_performance()
            
            logger.info("数据库性能分析完成")
            return performance_baseline
            
        except Exception as e:
            logger.error(f"性能分析失败: {e}")
            return {'error': str(e)}
    
    def _measure_query_performance(self) -> Dict[str, float]:
        """测量查询性能基线"""
        queries = [
            {
                'name': 'simple_select',
                'query': "SELECT code, date, close FROM stock_info WHERE date >= '2024-06-01' LIMIT 1000"
            },
            {
                'name': 'aggregation',
                'query': "SELECT code, COUNT(*) as cnt FROM stock_info WHERE date >= '2024-01-01' GROUP BY code LIMIT 100"
            },
            {
                'name': 'complex_filter',
                'query': "SELECT code, date, close, volume FROM stock_info WHERE close > 20 AND volume > 1000000 AND date >= '2024-05-01' LIMIT 500"
            }
        ]
        
        performance = {}
        
        for query_info in queries:
            try:
                start_time = time.time()
                result = self.client.query(query_info['query'])
                duration = time.time() - start_time
                
                performance[query_info['name']] = {
                    'duration': duration,
                    'records': len(result.result_rows)
                }
                
                logger.info(f"查询 {query_info['name']} 耗时: {duration:.3f}秒")
                
            except Exception as e:
                logger.error(f"查询 {query_info['name']} 失败: {e}")
                performance[query_info['name']] = {'error': str(e)}
        
        return performance
    
    def create_performance_indexes(self) -> Dict[str, Any]:
        """创建性能优化索引"""
        logger.info("开始创建性能优化索引...")
        
        if not self.client:
            return {'error': 'ClickHouse连接未建立'}
        
        # 定义要创建的索引
        indexes_to_create = [
            {
                'name': 'idx_date_code',
                'sql': "ALTER TABLE stock_info WHERE 1=1 ADD INDEX idx_date_code (date, code) TYPE minmax GRANULARITY 1",
                'description': '日期和股票代码复合索引，优化按日期和代码查询'
            },
            {
                'name': 'idx_code_date',
                'sql': "ALTER TABLE stock_info WHERE 1=1 ADD INDEX idx_code_date (code, date) TYPE minmax GRANULARITY 1",
                'description': '股票代码和日期复合索引，优化按代码查询历史数据'
            },
            {
                'name': 'idx_volume',
                'sql': "ALTER TABLE stock_info WHERE 1=1 ADD INDEX idx_volume (volume) TYPE minmax GRANULARITY 1",
                'description': '成交量索引，优化按成交量筛选'
            },
            {
                'name': 'idx_close_price',
                'sql': "ALTER TABLE stock_info WHERE 1=1 ADD INDEX idx_close_price (close) TYPE minmax GRANULARITY 1",
                'description': '收盘价索引，优化按价格筛选'
            }
        ]
        
        results = {
            'successful_indexes': [],
            'failed_indexes': [],
            'total_time': 0
        }
        
        start_time = time.time()
        
        for index_info in indexes_to_create:
            try:
                logger.info(f"创建索引: {index_info['name']}")
                
                index_start = time.time()
                self.client.command(index_info['sql'])
                index_duration = time.time() - index_start
                
                results['successful_indexes'].append({
                    'name': index_info['name'],
                    'description': index_info['description'],
                    'duration': index_duration
                })
                
                self.optimization_results['indexes_created'].append(index_info['name'])
                
                logger.info(f"索引 {index_info['name']} 创建成功，耗时: {index_duration:.3f}秒")
                
            except Exception as e:
                error_msg = str(e)
                
                # 检查是否是索引已存在的错误
                if 'already exists' in error_msg.lower() or 'duplicate' in error_msg.lower():
                    logger.info(f"索引 {index_info['name']} 已存在，跳过创建")
                    results['successful_indexes'].append({
                        'name': index_info['name'],
                        'description': index_info['description'],
                        'status': 'already_exists'
                    })
                else:
                    logger.error(f"创建索引 {index_info['name']} 失败: {e}")
                    results['failed_indexes'].append({
                        'name': index_info['name'],
                        'error': error_msg
                    })
                    self.optimization_results['errors'].append(f"索引创建失败: {index_info['name']} - {error_msg}")
        
        results['total_time'] = time.time() - start_time
        
        logger.info(f"索引创建完成，成功: {len(results['successful_indexes'])}，失败: {len(results['failed_indexes'])}")
        
        return results
    
    def optimize_table_settings(self) -> Dict[str, Any]:
        """优化表设置"""
        logger.info("开始优化表设置...")
        
        if not self.client:
            return {'error': 'ClickHouse连接未建立'}
        
        optimizations = []
        
        try:
            # 1. 优化表的存储设置
            logger.info("检查表存储设置...")
            
            # 获取当前表设置
            db_name = os.getenv('DB_DATABASE', 'stock')
            table_settings = self.client.query(f"SELECT code, name, date, level, open, close, high, low, volume FROM system.tables WHERE name = 'stock_info' AND database = '{db_name}'")
            
            if table_settings.result_rows:
                optimizations.append({
                    'type': 'table_analysis',
                    'description': '表存储设置已检查',
                    'status': 'completed'
                })
            
            # 2. 分析分区策略
            logger.info("分析分区策略...")
            
            # 检查是否需要分区
            date_range = self.client.query("SELECT MIN(date) as min_date, MAX(date) as max_date FROM stock_info WHERE date >= '2020-01-01'")
            
            if date_range.result_rows:
                min_date, max_date = date_range.result_rows[0]
                
                # 计算日期跨度
                from datetime import datetime
                if isinstance(min_date, str):
                    min_date = datetime.strptime(min_date, '%Y-%m-%d').date()
                if isinstance(max_date, str):
                    max_date = datetime.strptime(max_date, '%Y-%m-%d').date()
                
                date_span_years = (max_date - min_date).days / 365.25
                
                if date_span_years > 5:
                    optimizations.append({
                        'type': 'partition_recommendation',
                        'description': f'数据跨度 {date_span_years:.1f} 年，建议考虑按年或月分区',
                        'recommendation': 'ALTER TABLE stock_info WHERE 1=1 PARTITION BY toYYYYMM(date)',
                        'status': 'recommendation'
                    })
                else:
                    optimizations.append({
                        'type': 'partition_analysis',
                        'description': f'数据跨度 {date_span_years:.1f} 年，当前不需要分区',
                        'status': 'no_action_needed'
                    })
            
            # 3. 检查数据压缩
            logger.info("检查数据压缩设置...")
            
            db_name = os.getenv('DB_DATABASE', 'stock')
            table_size = self.client.query(f"""
                SELECT 
                    format_readable_size(sum(bytes)) as size,
                    sum(rows) as rows
                FROM system.parts 
                WHERE table = 'stock_info' AND database = '{db_name}'
            """)
            
            if table_size.result_rows:
                size, rows = table_size.result_rows[0]
                optimizations.append({
                    'type': 'storage_analysis',
                    'description': f'表大小: {size}，记录数: {rows}',
                    'status': 'analyzed'
                })
            
            self.optimization_results['optimizations_applied'].extend(optimizations)
            
            logger.info("表设置优化完成")
            return {'optimizations': optimizations}
            
        except Exception as e:
            logger.error(f"表设置优化失败: {e}")
            return {'error': str(e)}
    
    def measure_performance_improvement(self, baseline: Dict[str, Any]) -> Dict[str, Any]:
        """测量性能改进效果"""
        logger.info("开始测量性能改进效果...")
        
        if not self.client:
            return {'error': 'ClickHouse连接未建立'}
        
        try:
            # 重新测量查询性能
            current_performance = self._measure_query_performance()
            
            # 对比基线性能
            improvements = {}
            
            if 'query_baseline' in baseline:
                baseline_queries = baseline['query_baseline']
                
                for query_name, current_metrics in current_performance.items():
                    if query_name in baseline_queries and 'duration' in current_metrics and 'duration' in baseline_queries[query_name]:
                        baseline_duration = baseline_queries[query_name]['duration']
                        current_duration = current_metrics['duration']
                        
                        improvement_pct = ((baseline_duration - current_duration) / baseline_duration) * 100
                        
                        improvements[query_name] = {
                            'baseline_duration': baseline_duration,
                            'current_duration': current_duration,
                            'improvement_percent': improvement_pct,
                            'improvement_seconds': baseline_duration - current_duration
                        }
                        
                        logger.info(f"查询 {query_name} 性能改进: {improvement_pct:.1f}%")
            
            self.optimization_results['performance_improvements'] = improvements
            
            return {
                'current_performance': current_performance,
                'improvements': improvements
            }
            
        except Exception as e:
            logger.error(f"性能测量失败: {e}")
            return {'error': str(e)}
    
    def generate_optimization_report(self) -> str:
        """生成优化报告"""
        logger.info("生成优化报告...")
        
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        report_file = f"optimization_reports/database_optimization_report_{timestamp}.md"
        
        # 创建报告目录
        os.makedirs("optimization_reports", exist_ok=True)
        
        try:
            with open(report_file, 'w', encoding='utf-8') as f:
                f.write("# 数据库性能优化报告\n\n")
                f.write(f"**优化时间**: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n")
                
                # 索引创建结果
                f.write("## 📊 索引优化结果\n\n")
                if self.optimization_results['indexes_created']:
                    f.write("### ✅ 成功创建的索引\n\n")
                    for idx in self.optimization_results['indexes_created']:
                        f.write(f"- {idx}\n")
                    f.write("\n")
                
                # 性能改进
                f.write("## 🚀 性能改进效果\n\n")
                if self.optimization_results['performance_improvements']:
                    for query_name, improvement in self.optimization_results['performance_improvements'].items():
                        f.write(f"### {query_name}\n")
                        f.write(f"- **基线耗时**: {improvement['baseline_duration']:.3f}秒\n")
                        f.write(f"- **优化后耗时**: {improvement['current_duration']:.3f}秒\n")
                        f.write(f"- **性能提升**: {improvement['improvement_percent']:.1f}%\n")
                        f.write(f"- **时间节省**: {improvement['improvement_seconds']:.3f}秒\n\n")
                
                # 应用的优化
                f.write("## 🔧 应用的优化措施\n\n")
                if self.optimization_results['optimizations_applied']:
                    for opt in self.optimization_results['optimizations_applied']:
                        f.write(f"- **{opt.get('type', 'unknown')}**: {opt.get('description', 'N/A')}\n")
                    f.write("\n")
                
                # 错误和问题
                if self.optimization_results['errors']:
                    f.write("## ⚠️ 遇到的问题\n\n")
                    for error in self.optimization_results['errors']:
                        f.write(f"- {error}\n")
                    f.write("\n")
                
                f.write("---\n\n")
                f.write("*本报告由数据库优化脚本自动生成*\n")
            
            logger.info(f"优化报告已保存: {report_file}")
            return report_file
            
        except Exception as e:
            logger.error(f"生成优化报告失败: {e}")
            return None
    
    def run_full_optimization(self) -> Dict[str, Any]:
        """运行完整的数据库优化流程"""
        logger.info("=" * 80)
        logger.info("开始数据库性能优化")
        logger.info("=" * 80)
        
        results = {
            'start_time': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'baseline_analysis': {},
            'index_optimization': {},
            'table_optimization': {},
            'performance_measurement': {},
            'report_file': None,
            'success': False
        }
        
        try:
            # 1. 分析当前性能基线
            logger.info("步骤 1: 分析当前性能基线")
            baseline = self.analyze_current_performance()
            results['baseline_analysis'] = baseline
            
            if 'error' in baseline:
                logger.error(f"基线分析失败: {baseline['error']}")
                return results
            
            # 2. 创建性能索引
            logger.info("步骤 2: 创建性能优化索引")
            index_results = self.create_performance_indexes()
            results['index_optimization'] = index_results
            
            # 3. 优化表设置
            logger.info("步骤 3: 优化表设置")
            table_results = self.optimize_table_settings()
            results['table_optimization'] = table_results
            
            # 4. 测量性能改进
            logger.info("步骤 4: 测量性能改进效果")
            performance_results = self.measure_performance_improvement(baseline)
            results['performance_measurement'] = performance_results
            
            # 5. 生成优化报告
            logger.info("步骤 5: 生成优化报告")
            report_file = self.generate_optimization_report()
            results['report_file'] = report_file
            
            results['success'] = True
            results['end_time'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
            
            logger.info("数据库性能优化完成")
            
        except Exception as e:
            logger.error(f"优化过程中发生错误: {e}")
            results['error'] = str(e)
        
        return results


def main_databaseoptimization():
    """主函数"""
    print("=" * 80)
    print("数据库性能优化工具")
    print("基于性能测试结果，自动优化ClickHouse数据库")
    print("=" * 80)
    print(f"开始时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print()
    
    try:
        # 创建优化器实例
        optimizer = DatabaseOptimizer()
        
        # 运行完整优化
        results = optimizer.run_full_optimization()
        
        # 显示结果摘要
        print("=" * 80)
        print("优化结果摘要")
        print("=" * 80)
        
        if results['success']:
            print("✅ 数据库优化成功完成")
            
            # 索引优化结果
            index_results = results.get('index_optimization', {})
            if 'successful_indexes' in index_results:
                print(f"📊 成功创建索引: {len(index_results['successful_indexes'])}个")
            
            # 性能改进结果
            perf_results = results.get('performance_measurement', {})
            if 'improvements' in perf_results:
                improvements = perf_results['improvements']
                if improvements:
                    avg_improvement = sum(imp['improvement_percent'] for imp in improvements.values()) / len(improvements)
                    print(f"🚀 平均性能提升: {avg_improvement:.1f}%")
            
            # 报告文件
            if results['report_file']:
                print(f"📄 详细报告: {results['report_file']}")
            
            print("\n🎉 数据库优化完成，系统性能已提升！")
            return 0
        else:
            print("❌ 数据库优化失败")
            if 'error' in results:
                print(f"错误信息: {results['error']}")
            return 1
            
    except Exception as e:
        print(f"❌ 优化过程中发生错误: {e}")
        import traceback
        traceback.print_exc()
        return 1


if __name__ == '__main__':
    exit_code = main_databaseoptimization()
    sys.exit(exit_code)
