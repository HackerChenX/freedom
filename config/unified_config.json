{
  "database": {
    "host": "localhost",
    "port": 9000,
    "user": "default",
    "password": "123456",
    "name": "stock",
    "timeout": 30,
    "compression": true
  },
  "cache": {
    "max_size": 100,
    "ttl": 3600,
    "size": 1000,
    "enabled": true
  },
  "performance": {
    "timeout": 30,
    "max_connections": 20,
    "pool_size": 10,
    "batch_size": 1000
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/app.log"
  },
  "paths": {
    "logs": "logs",
    "data": "data",
    "output": "output",
    "temp": "temp"
  }
}