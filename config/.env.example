# ClickHouse数据库配置环境变量模板
# 复制此文件为 .env 并修改配置

# ClickHouse连接配置
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=stock
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here

# 连接超时配置
CLICKHOUSE_TIMEOUT=30

# 加密密钥（可选，用于密码加密）
# CLICKHOUSE_ENCRYPTION_KEY=your_base64_encoded_key_here

# 其他可选配置
# CLICKHOUSE_COMPRESSION=true
# CLICKHOUSE_POOL_MIN_SIZE=5
# CLICKHOUSE_POOL_MAX_SIZE=20

# 开发环境示例
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_PASSWORD=123456

# 测试环境示例
# CLICKHOUSE_HOST=test-clickhouse.example.com
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_PASSWORD=test_password

# 生产环境示例
# CLICKHOUSE_HOST=prod-clickhouse.example.com
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_PASSWORD=secure_production_password
