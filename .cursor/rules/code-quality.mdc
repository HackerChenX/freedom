### 类型注解要求

所有公共接口必须使用类型注解：

```python
from typing import Dict, List, Optional, Union, Callable, Any
from datetime import datetime
from vnpy.trader.object import BarData, TickData

class DataProcessor:
    """数据处理器"""
    
    def __init__(self, window_size: int = 100) -> None:
        """构造函数"""
        self.window_size: int = window_size
        self.data_cache: List[BarData] = []
        
    def process_bars(self, bars: List[BarData]) -> Dict[str, float]:
        """处理K线数据"""
        if not bars:
            return {}
            
        # 计算技术指标
        indicators: Dict[str, float] = self._calculate_indicators(bars)
        return indicators
    
    def _calculate_indicators(self, bars: List[BarData]) -> Dict[str, float]:
        """计算技术指标（私有方法）"""
        prices: List[float] = [bar.close_price for bar in bars]
        
        return {
            "sma_20": self._sma(prices, 20),
            "sma_60": self._sma(prices, 60),
            "volatility": self._calculate_volatility(prices)
        }
    
    def _sma(self, values: List[float], period: int) -> Optional[float]:
        """简单移动平均"""
        if len(values) < period:
            return None
        return sum(values[-period:]) / period
    
    def _calculate_volatility(self, prices: List[float]) -> float:
        """计算波动率"""
        if len(prices) < 2:
            return 0.0
        
        returns: List[float] = []
        for i in range(1, len(prices)):
            ret = (prices[i] - prices[i-1]) / prices[i-1]
            returns.append(ret)
            
        if not returns:
            return 0.0
            
        mean_return = sum(returns) / len(returns)
        variance = sum((r - mean_return) ** 2 for r in returns) / len(returns)
        return variance ** 0.5
```

