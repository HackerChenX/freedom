## 错误处理规范

### 异常处理层次

```python
# 1. 系统级异常 - 记录并重新抛出
try:
    result = self.critical_operation()
except (ConnectionError, SystemError) as e:
    self.write_log(f"系统错误: {e}")
    raise  # 重新抛出，让上层处理

# 2. 业务级异常 - 处理并返回默认值
try:
    data = self.parse_market_data(raw_data)
except (ValueError, KeyError) as e:
    self.write_log(f"数据解析失败: {e}")
    return None  # 返回默认值

# 3. 预期异常 - 优雅处理
try:
    price = float(price_str)
except ValueError:
    self.write_log(f"价格格式错误: {price_str}")
    price = 0.0
```

### 自定义异常类

```python
class VnPyFreedomError(Exception):
    """VnPy Freedom基础异常"""
    pass

class DataValidationError(VnPyFreedomError):
    """数据验证错误"""
    def __init__(self, field: str, value: Any, message: str = ""):
        self.field = field
        self.value = value
        super().__init__(f"字段 {field} 验证失败: {value}. {message}")

class ModuleLoadError(VnPyFreedomError):
    """模块加载错误"""
    def __init__(self, module_name: str, reason: str):
        self.module_name = module_name
        self.reason = reason
        super().__init__(f"模块 {module_name} 加载失败: {reason}")

# 使用示例
def validate_bar_data(bar: BarData) -> None:
    """验证K线数据"""
    if bar.high_price < bar.low_price:
        raise DataValidationError(
            "high_price", bar.high_price, 
            f"最高价不能小于最低价 {bar.low_price}"
        )
    
    if bar.volume < 0:
        raise DataValidationError(
            "volume", bar.volume,
            "成交量不能为负数"
        )
```

## 性能优化指导

### 数据处理优化

```python
# ❌ 低效：频繁的列表操作
def calculate_sma_slow(prices: List[float], period: int) -> List[float]:
    """低效的移动平均计算"""
    result = []
    for i in range(len(prices)):
        if i >= period - 1:
            window = prices[i-period+1:i+1]
            result.append(sum(window) / period)
        else:
            result.append(0.0)
    return result

# ✅ 高效：使用NumPy向量化操作
import numpy as np

def calculate_sma_fast(prices: np.ndarray, period: int) -> np.ndarray:
    """高效的移动平均计算"""
    if len(prices) < period:
        return np.zeros_like(prices)
    
    # 使用pandas rolling更高效
    import pandas as pd
    series = pd.Series(prices)
    return series.rolling(window=period, min_periods=1).mean().values

# ✅ 内存友好：生成器处理大数据
def process_large_dataset(data_source: Iterator[BarData]) -> Iterator[Dict[str, float]]:
    """流式处理大数据集"""
    window = []
    window_size = 100
    
    for bar in data_source:
        window.append(bar)
        
        # 保持窗口大小
        if len(window) > window_size:
            window.pop(0)
        
        # 计算指标
        if len(window) >= 20:  # 最小窗口
            indicators = calculate_indicators(window)
            yield indicators
```

### 缓存策略

```python
from functools import lru_cache
from typing import Tuple
import weakref

class CachedIndicatorCalculator:
    """带缓存的指标计算器"""
    
    def __init__(self):
        self._cache: Dict[Tuple, float] = {}
        self._weak_cache = weakref.WeakValueDictionary()
    
    @lru_cache(maxsize=128)
    def _calculate_sma(self, prices_tuple: Tuple[float, ...], period: int) -> float:
        """缓存的SMA计算"""
        prices = list(prices_tuple)
        if len(prices) < period:
            return 0.0
        return sum(prices[-period:]) / period
    
    def calculate_sma(self, prices: List[float], period: int) -> float:
        """公共SMA接口"""
        # 转换为元组用于缓存键
        prices_tuple = tuple(prices[-100:])  # 只使用最近100个数据点
        return self._calculate_sma(prices_tuple, period)
    
    def clear_cache(self) -> None:
        """清理缓存"""
        self._calculate_sma.cache_clear()
        self._cache.clear()
```

### 并发处理

```python
import asyncio
from concurrent.futures import ThreadPoolExecutor, ProcessPoolExecutor
from typing import List, Callable, Any

class ParallelProcessor:
    """并行处理器"""
    
    def __init__(self, max_workers: int = 4):
        self.max_workers = max_workers
    
    def process_symbols_parallel(
        self,
        symbols: List[str],
        process_func: Callable[[str], Any],
        use_process: bool = False
    ) -> List[Any]:
        """并行处理多个交易品种"""
        executor_class = ProcessPoolExecutor if use_process else ThreadPoolExecutor
        
        with executor_class(max_workers=self.max_workers) as executor:
            futures = [executor.submit(process_func, symbol) for symbol in symbols]
            results = []
            
            for future in futures:
                try:
                    result = future.result(timeout=30)  # 30秒超时
                    results.append(result)
                except Exception as e:
                    print(f"处理失败: {e}")
                    results.append(None)
                    
        return results
    
    async def async_data_fetch(self, urls: List[str]) -> List[Any]:
        """异步数据获取"""
        async def fetch_one(url: str) -> Any:
            # 异步HTTP请求实现
            await asyncio.sleep(0.1)  # 模拟网络延迟
            return f"data_from_{url}"
        
        tasks = [fetch_one(url) for url in urls]
        results = await asyncio.gather(*tasks, return_exceptions=True)
        
        return [r for r in results if not isinstance(r, Exception)]
