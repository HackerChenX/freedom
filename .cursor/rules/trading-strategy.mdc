## 实盘交易集成

### 实盘策略部署

```python
def deploy_live_strategy():
    """部署实盘策略"""
    from vnpy_ctastrategy import CtaStrategyApp, CtaEngine
    
    # 获取策略引擎
    cta_engine = main_engine.get_engine(CtaStrategyApp.app_name)
    
    # 添加策略实例
    cta_engine.add_strategy(
        class_name="MultiTimeframeStrategy",
        strategy_name="multi_tf_001",
        vt_symbol="000001.SZSE",
        setting={
            "fast_ma_length": 20,
            "slow_ma_length": 60,
            "risk_ratio": 0.02
        }
    )
    
    # 初始化策略
    cta_engine.init_strategy("multi_tf_001")
    
    # 启动策略
    cta_engine.start_strategy("multi_tf_001")
```

### 监控和告警

```python
def setup_monitoring():
    """设置策略监控"""
    
    def check_strategy_health():
        """策略健康检查"""
        for strategy_name in cta_engine.strategies:
            strategy = cta_engine.strategies[strategy_name]
            
            # 检查策略状态
            if not strategy.trading:
                send_alert(f"策略 {strategy_name} 已停止交易")
                
            # 检查持仓风险
            if abs(strategy.pos) > strategy.max_position:
                send_alert(f"策略 {strategy_name} 持仓超限")
                
            # 检查盈亏
            if strategy.pnl < -strategy.max_loss:
                send_alert(f"策略 {strategy_name} 亏损超限")
                
    # 定时健康检查
    import threading
    timer = threading.Timer(60.0, check_strategy_health)
    timer.start()

def send_alert(message: str):
    """发送告警消息"""
    # 可以集成邮件、短信、微信等告警方式
    print(f"🚨 策略告警: {message}")
    
    # 记录到日志
    logger.warning(f"策略告警: {message}")
```

## 策略评估指标

### 绩效分析

```python
def analyze_strategy_performance(trades: List[TradeData]) -> Dict:
    """策略绩效分析"""
    if not trades:
        return {}
    
    # 基础统计
    total_trades = len(trades)
    winning_trades = len([t for t in trades if t.pnl > 0])
    losing_trades = total_trades - winning_trades
    
    win_rate = winning_trades / total_trades if total_trades > 0 else 0
    
    # 盈亏分析
    total_pnl = sum(t.pnl for t in trades)
    avg_pnl = total_pnl / total_trades if total_trades > 0 else 0
    
    winning_pnl = sum(t.pnl for t in trades if t.pnl > 0)
    losing_pnl = sum(t.pnl for t in trades if t.pnl < 0)
    
    avg_winning = winning_pnl / winning_trades if winning_trades > 0 else 0
    avg_losing = losing_pnl / losing_trades if losing_trades > 0 else 0
    
    # 风险指标
    profit_factor = abs(winning_pnl / losing_pnl) if losing_pnl != 0 else 0
    
    return {
        "total_trades": total_trades,
        "win_rate": win_rate,
        "total_pnl": total_pnl,
        "avg_pnl": avg_pnl,
        "profit_factor": profit_factor,
        "avg_winning": avg_winning,
        "avg_losing": avg_losing,
    }
```