# 部署运维管理规范

## 环境配置管理

### 开发环境设置

基于项目的[本地开发指南](mdc:LOCAL_DEVELOPMENT.md)：

```bash
# Python环境配置
python3.11 -m venv vnpy_freedom_env
source vnpy_freedom_env/bin/activate  # Linux/macOS
# vnpy_freedom_env\Scripts\activate   # Windows

# 依赖安装
pip install -U pip setuptools wheel
pip install -r requirements.txt

# 开发工具安装
pip install black isort mypy flake8 pytest pytest-cov
```

### 生产环境配置

```bash
#!/bin/bash
# production_setup.sh

set -e  # 遇到错误立即退出

echo "🚀 VnPy Freedom 生产环境部署"

# 1. 系统依赖检查
check_system_requirements() {
    echo "检查系统依赖..."
    
    # Python版本检查
    if ! python3.11 --version >/dev/null 2>&1; then
        echo "❌ 需要Python 3.11"
        exit 1
    fi
    
    # 内存检查
    total_memory=$(free -m | awk 'NR==2{printf "%.0f", $2}')
    if [ "$total_memory" -lt 4096 ]; then
        echo "⚠️  建议至少4GB内存"
    fi
    
    echo "✅ 系统检查通过"
}

# 2. 安全配置
setup_security() {
    echo "配置安全设置..."
    
    # 创建专用用户
    if ! id "vnpy" &>/dev/null; then
        sudo useradd -m -s /bin/bash vnpy
        echo "✅ 创建vnpy用户"
    fi
    
    # 设置文件权限
    chmod 700 /home/vnpy/vnpy_freedom
    chmod 600 /home/vnpy/vnpy_freedom/config/*.json
    
    echo "✅ 安全配置完成"
}

# 3. 服务配置
setup_systemd_service() {
    echo "配置系统服务..."
    
    cat > /etc/systemd/system/vnpy-freedom.service << EOF
[Unit]
Description=VnPy Freedom Trading Platform
After=network.target

[Service]
Type=simple
User=vnpy
Group=vnpy
WorkingDirectory=/home/vnpy/vnpy_freedom
ExecStart=/home/vnpy/vnpy_freedom_env/bin/python run_vnpy_freedom.py --daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# 环境变量
Environment=PYTHONPATH=/home/vnpy/vnpy_freedom
Environment=VNPY_FREEDOM_CONFIG=/home/vnpy/vnpy_freedom/config

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable vnpy-freedom
    echo "✅ 系统服务配置完成"
}

# 执行部署步骤
check_system_requirements
setup_security
setup_systemd_service

echo "🎉 生产环境部署完成"
```

