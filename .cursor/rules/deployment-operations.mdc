### 应用性能监控

```python
# performance/profiler.py
"""性能分析器"""

import cProfile
import pstats
import functools
import time
import memory_profiler
from typing import Callable, Any

class PerformanceProfiler:
    """性能分析器"""
    
    def __init__(self):
        """初始化"""
        self.profiles = {}
        self.timing_data = {}
    
    def profile_function(self, func: Callable) -> Callable:
        """函数性能分析装饰器"""
        @functools.wraps(func)
        def wrapper(*args, **kwargs):
            # 时间分析
            start_time = time.perf_counter()
            
            # 内存分析
            start_memory = memory_profiler.memory_usage()[0]
            
            # 执行函数
            result = func(*args, **kwargs)
            
            # 记录性能数据
            end_time = time.perf_counter()
            end_memory = memory_profiler.memory_usage()[0]
            
            duration = end_time - start_time
            memory_diff = end_memory - start_memory
            
            self._record_performance(func.__name__, duration, memory_diff)
            
            return result
        
        return wrapper
    
    def profile_method(self, method_name: str):
        """方法性能分析装饰器"""
        def decorator(func: Callable) -> Callable:
            @functools.wraps(func)
            def wrapper(*args, **kwargs):
                profiler = cProfile.Profile()
                profiler.enable()
                
                try:
                    result = func(*args, **kwargs)
                    return result
                finally:
                    profiler.disable()
                    
                    # 保存性能数据
                    stats = pstats.Stats(profiler)
                    self.profiles[method_name] = stats
            
            return wrapper
        return decorator
    
    def _record_performance(self, func_name: str, duration: float, memory_diff: float):
        """记录性能数据"""
        if func_name not in self.timing_data:
            self.timing_data[func_name] = {
                "calls": 0,
                "total_time": 0,
                "max_time": 0,
                "min_time": float('inf'),
                "memory_usage": []
            }
        
        data = self.timing_data[func_name]
        data["calls"] += 1
        data["total_time"] += duration
        data["max_time"] = max(data["max_time"], duration)
        data["min_time"] = min(data["min_time"], duration)
        data["memory_usage"].append(memory_diff)
    
    def generate_report(self) -> str:
        """生成性能报告"""
        report = ["性能分析报告", "=" * 50]
        
        for func_name, data in self.timing_data.items():
            avg_time = data["total_time"] / data["calls"]
            avg_memory = sum(data["memory_usage"]) / len(data["memory_usage"])
            
            report.extend([
                f"\n函数: {func_name}",
                f"  调用次数: {data['calls']}",
                f"  总时间: {data['total_time']:.4f}s",
                f"  平均时间: {avg_time:.4f}s",
                f"  最长时间: {data['max_time']:.4f}s",
                f"  最短时间: {data['min_time']:.4f}s",
                f"  平均内存: {avg_memory:.2f}MB"
            ])
        
        return "\n".join(report)

# 使用示例
