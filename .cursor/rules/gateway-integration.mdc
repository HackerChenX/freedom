### 数据对象转换

```python
def parse_contract_data(raw_data: dict) -> ContractData:
    """解析合约信息"""
    return ContractData(
        symbol=raw_data["symbol"],
        exchange=Exchange.CUSTOM,
        name=raw_data["baseAsset"] + "/" + raw_data["quoteAsset"],
        product=PRODUCT_EXCHANGE2VT[raw_data["type"]],
        size=1,
        pricetick=float(raw_data["tickSize"]),
        min_volume=float(raw_data["minQty"]),
        stop_supported=True,
        net_position=True,
        history_data=True,
        gateway_name=self.gateway_name
    )

def parse_account_data(raw_data: dict) -> AccountData:
    """解析账户信息"""
    return AccountData(
        accountid=raw_data["accountType"],
        balance=float(raw_data["totalWalletBalance"]),
        frozen=float(raw_data["totalInitialMargin"]),
        gateway_name=self.gateway_name
    )

def parse_position_data(raw_data: dict) -> PositionData:
    """解析持仓信息"""
    return PositionData(
        symbol=raw_data["symbol"],
        exchange=Exchange.CUSTOM,
        direction=Direction.NET,
        volume=float(raw_data["positionAmt"]),
        frozen=0,
        price=float(raw_data["entryPrice"]),
        pnl=float(raw_data["unrealizedPnl"]),
        yd_volume=0,
        gateway_name=self.gateway_name
    )
