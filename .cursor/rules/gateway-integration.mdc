## 错误处理和重连

### 错误处理机制

```python
def on_error(self, exception_type: type, exception_value: Exception, tb) -> None:
    """错误处理"""
    error_msg = f"网关错误: {exception_type.__name__}: {exception_value}"
    self.gateway.write_log(error_msg)
    
    # 根据错误类型处理
    if isinstance(exception_value, ConnectionError):
        self.handle_connection_error()
    elif isinstance(exception_value, TimeoutError):
        self.handle_timeout_error()
    elif "API key" in str(exception_value):
        self.handle_auth_error()
    else:
        self.handle_general_error(exception_value)

def handle_connection_error(self) -> None:
    """处理连接错误"""
    self.gateway.write_log("检测到连接错误，尝试重连...")
    
    # 停止当前连接
    self.stop()
    
    # 延迟重连
    threading.Timer(5.0, self.reconnect).start()

def reconnect(self) -> None:
    """重新连接"""
    try:
        self.start()
        self.gateway.write_log("重连成功")
        
        # 重新订阅
        for vt_symbol in self.subscriptions:
            req = SubscribeRequest(symbol=vt_symbol.split(".")[0], exchange=Exchange.CUSTOM)
            self.subscribe(req)
            
    except Exception as e:
        self.gateway.write_log(f"重连失败: {e}")
        # 继续尝试重连
        threading.Timer(10.0, self.reconnect).start()
```

### 限频控制

```python
class RateLimiter:
    """请求限频器"""
    
    def __init__(self, max_requests: int, time_window: int):
        """构造函数"""
        self.max_requests = max_requests
        self.time_window = time_window
        self.requests = []
        self.lock = threading.Lock()
    
    def can_request(self) -> bool:
        """检查是否可以发送请求"""
        with self.lock:
            now = time.time()
            
            # 清理过期请求
            self.requests = [req_time for req_time in self.requests 
                           if now - req_time < self.time_window]
            
            # 检查是否超过限制
            if len(self.requests) >= self.max_requests:
                return False
            
            # 记录新请求
            self.requests.append(now)
            return True
    
    def wait_if_needed(self) -> None:
        """如果需要则等待"""
        while not self.can_request():
            time.sleep(0.1)

# 在REST客户端中使用
class CustomRestApi(RestClient):
    def __init__(self, gateway: CustomGateway):
        super().__init__()
        self.gateway = gateway
        
        # 创建限频器（例如：100请求/分钟）
        self.rate_limiter = RateLimiter(100, 60)
    
    def add_request(self, method: str, path: str, **kwargs) -> None:
        """添加请求（带限频控制）"""
        self.rate_limiter.wait_if_needed()
        super().add_request(method, path, **kwargs)
