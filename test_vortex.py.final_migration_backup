logger = get_logger(__name__)

def get_test_data(code: str = "000001.SZ", limit: int = 100) -> pd.DataFrame:
    """获取测试数据"""
    try:
        data_access = get_container().resolve(IData_access)
        
        # 获取股票数据
        query = f"""
        SELECT 
            trade_date as date,
            ts_code as code,
            open,
            high,
            low,
            close,
            vol as volume,
            amount as turnover
        FROM stock_info WHERE 1=1
        WHERE ts_code = '{code}'
        ORDER BY trade_date DESC
        LIMIT {limit}
        """
        
        df = data_access.execute_query(query)
        if df.empty:
            logger.warning(f"未找到股票 {code} 的数据")
            return pd.Data_frame()
        
        # 数据按日期升序排列
        df = df.sort_values('date').reset_index(drop=True)
        
        logger.info(f"获取到 {len(df)} 条数据，日期范围: {df['date'].min()} 到 {df['date'].max()}")
        return df
        
    except Exception as e:
        logger.error(f"获取测试数据失败: {e}")
        return pd.Data_frame()

def test_vortex_calculation():
    """测试VORTEX指标计算功能"""
    print("=" * 60)
    print("测试VORTEX指标计算功能")
    print("=" * 60)
    
    # 获取测试数据
    data = get_test_data("000001.SZ", 100)
    if data.empty:
        print("无法获取测试数据")
        return
    
    # 创建VORTEX指标实例
    vortex = VORTEX(period=14)
    
    # 计算指标
    result = vortex.calculate(data)
    
    # 检查结果
    print(f"数据长度: {len(result)}")
    print(f"VORTEX指标列: {[col for col in result.columns if 'VI' in col or 'VORTEX' in col]}")
    
    # 显示最近的数据
    vortex_cols = ['VI_PLUS', 'VI_MINUS', 'VORTEX_DIFF', 'VORTEX_RATIO', 'VORTEX_STRENGTH', 'VORTEX_TREND']
    available_cols = [col for col in vortex_cols if col in result.columns]
    
    print("\n最近10天的VORTEX指标值:")
    print(result[['date', 'close'] + available_cols].tail(10).to_string(index=False))
    
    # 检查计算结果的合理性
    vi_plus = result['VI_PLUS'].dropna()
    vi_minus = result['VI_MINUS'].dropna()
    
    if len(vi_plus) > 0 and len(vi_minus) > 0:
        print(f"\nVI_PLUS统计:")
        print(f"  范围: {vi_plus.min():.4f} - {vi_plus.max():.4f}")
        print(f"  平均: {vi_plus.mean():.4f}")
        print(f"  标准差: {vi_plus.std():.4f}")
        
        print(f"\nVI_MINUS统计:")
        print(f"  范围: {vi_minus.min():.4f} - {vi_minus.max():.4f}")
        print(f"  平均: {vi_minus.mean():.4f}")
        print(f"  标准差: {vi_minus.std():.4f}")
        
        # 检查VI+和VI-的相关性
        correlation = vi_plus.corr(vi_minus)
        print(f"\nVI+和VI-的相关性: {correlation:.4f}")
        
        # 检查交叉情况
        crossings = sum((vi_plus > vi_minus) != (vi_plus.shift(1) > vi_minus.shift(1)))
        print(f"交叉次数: {crossings}")
        
        # 检查趋势分布
        if 'VORTEX_TREND' in result.columns:
            trend_counts = result['VORTEX_TREND'].value_counts()
            print(f"\n趋势分布:")
            for trend, count in trend_counts.items():
                trend_name = "上升" if trend == 1 else "下降" if trend == -1 else "横盘"
                print(f"  {trend_name}: {count} 天 ({count/len(result)*100:.1f}%)")
    
    return result

def test_vortex_scoring():
    """测试VORTEX指标评分功能"""
    print("\n" + "=" * 60)
    print("测试VORTEX指标评分功能")
    print("=" * 60)
    
    # 获取测试数据
    data = get_test_data("000001.SZ", 100)
    if data.empty:
        print("无法获取测试数据")
        return
    
    # 创建VORTEX指标实例
    vortex = VORTEX(period=14)
    
    # 计算指标和评分
    result = vortex.calculate(data)
    scores = vortex.calculate_raw_score(data)
    
    # 分析评分
    valid_scores = scores.dropna()
    if len(valid_scores) > 0:
        print(f"评分统计:")
        print(f"  有效评分数量: {len(valid_scores)}")
        print(f"  评分范围: {valid_scores.min():.2f} - {valid_scores.max():.2f}")
        print(f"  平均评分: {valid_scores.mean():.2f}")
        print(f"  标准差: {valid_scores.std():.2f}")
        print(f"  唯一值数量: {len(valid_scores.unique())}")
        
        # 评分分布
        print(f"\n评分分布:")
        score_ranges = [(0, 40), (40, 45), (45, 50), (50, 55), (55, 60), (60, 100)]
        for low, high in score_ranges:
            count = len(valid_scores[(valid_scores >= low) & (valid_scores < high)])
            print(f"  {low}-{high}: {count} 个 ({count/len(valid_scores)*100:.1f}%)")
        
        # 显示最近的评分
        print(f"\n最近10天的评分:")
        recent_data = pd.Data_frame({
            'date': result['date'].tail(10),
            'close': result['close'].tail(10),
            'VI_PLUS': result['VI_PLUS'].tail(10),
            'VI_MINUS': result['VI_MINUS'].tail(10),
            'VORTEX_DIFF': result['VORTEX_DIFF'].tail(10),
            'score': scores.tail(10)
        })
        print(recent_data.to_string(index=False, float_format='%.4f'))
        
        # 计算置信度
        patterns = vortex.get_patterns(data)
        signals = {
            'buy': result['buy_signal'].sum() if 'buy_signal' in result.columns else 0,
            'sell': result['sell_signal'].sum() if 'sell_signal' in result.columns else 0,
            'hold': result['hold_signal'].sum() if 'hold_signal' in result.columns else 0
        }
        confidence = vortex.calculate_confidence(scores, patterns, signals)
        print(f"\n置信度: {confidence:.3f}")
    
    return scores

