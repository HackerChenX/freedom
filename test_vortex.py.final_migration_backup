def test_multiple_stocks():
    """测试多只股票的VORTEX指标"""
    print("\n" + "=" * 60)
    print("测试多只股票的VORTEX指标")
    print("=" * 60)
    
    # 测试股票列表
    test_stocks = ["000001.SZ", "000002.SZ", "600000.SH"]
    
    vortex = VORTEX(period=14)
    results = {}
    
    for stock in test_stocks:
        print(f"\n测试股票: {stock}")
        data = get_test_data(stock, 50)
        if data.empty:
            print(f"  无数据")
            continue
        
        try:
            result = vortex.calculate(data)
            scores = vortex.calculate_raw_score(data)
            
            valid_scores = scores.dropna()
            if len(valid_scores) > 0:
                print(f"  数据天数: {len(data)}")
                print(f"  有效评分: {len(valid_scores)}")
                print(f"  评分范围: {valid_scores.min():.2f} - {valid_scores.max():.2f}")
                print(f"  平均评分: {valid_scores.mean():.2f}")
                print(f"  最新VI+: {result['VI_PLUS'].iloc[-1]:.4f}")
                print(f"  最新VI-: {result['VI_MINUS'].iloc[-1]:.4f}")
                print(f"  最新评分: {scores.iloc[-1]:.2f}")
                
                results[stock] = {
                    'data_count': len(data),
                    'valid_scores': len(valid_scores),
                    'score_range': (valid_scores.min(), valid_scores.max()),
                    'avg_score': valid_scores.mean(),
                    'latest_vi_plus': result['VI_PLUS'].iloc[-1],
                    'latest_vi_minus': result['VI_MINUS'].iloc[-1],
                    'latest_score': scores.iloc[-1]
                }
        except Exception as e:
            print(f"  计算失败: {e}")
    
    # 汇总结果
    if results:
        print(f"\n汇总结果:")
        for stock, data in results.items():
            print(f"{stock}: 评分{data['latest_score']:.2f}, VI+={data['latest_vi_plus']:.4f}, VI-={data['latest_vi_minus']:.4f}")
    
    return results

